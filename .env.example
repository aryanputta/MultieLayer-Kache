# Copy this to .env and fill in values before running docker-compose
# NEVER commit .env to git

# Grafana credentials (required)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_before_running

# Optional: HuggingFace token (for gated models like Llama-3)
# HF_TOKEN=hf_...

# Optional: Weights & Biases (for experiment tracking)
# WANDB_API_KEY=...

# Optional: MLflow tracking server
# MLFLOW_TRACKING_URI=http://localhost:5000
